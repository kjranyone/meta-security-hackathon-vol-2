// Geopolitics Terrarium — ビジュアルレポート (typst版)
// 既存の slides.html (12スライド) をtypstに移植。
// ビルド: typst compile report/slides.typ  (rootはこのファイルの親ディレクトリ)

#let bg     = rgb("#0d1117")
#let panel  = rgb("#161b22")
#let border = rgb("#30363d")
#let fg     = rgb("#e6edf3")
#let sub    = rgb("#9198a1")
#let accent = rgb("#f0883e")
#let blue   = rgb("#58a6ff")
#let red    = rgb("#e5534b")
#let green  = rgb("#3fb950")
#let purple = rgb("#d6a8ff")

#set page(
  paper: "presentation-16-9",
  fill: bg,
  margin: (top: 11mm, bottom: 10mm, x: 13mm),
  footer: context {
    set text(size: 7pt, fill: sub)
    grid(
      columns: (1fr, auto),
      [Geopolitics Terrarium],
      [#counter(page).display() \/ #counter(page).final().first()],
    )
  },
)

#set text(font: ("Hiragino Sans", "Hiragino Kaku Gothic ProN"), lang: "ja", size: 9.5pt, fill: fg)
#set par(justify: true, leading: 0.72em)
#set list(tight: false, spacing: 4.5pt, indent: 7pt, marker: text(fill: accent, size: 8pt)[▸])
#set enum(tight: false, spacing: 5pt)
#show raw: set text(font: "DejaVu Sans Mono", size: 7.8pt)
#show raw.where(block: false): box.with(fill: panel, inset: (x: 3.5pt, y: 0pt), outset: (y: 2.5pt), radius: 3pt)
#show raw.where(block: true): block.with(fill: panel, inset: 8pt, radius: 5pt, width: 100%)

// ---- ヘルパ --------------------------------------------------------------
#let h2(s) = block(width: 100%, stroke: (bottom: 1.2pt + border), inset: (bottom: 5pt), below: 9pt)[
  #text(size: 15pt, fill: accent, weight: "bold")[#s]
]
#let h3(s) = block(above: 8pt, below: 3pt)[
  #text(size: 10.5pt, fill: blue, weight: "bold")[#s]
]
#let note(body, size: 8.6pt) = rect(fill: panel, stroke: 0.8pt + border, radius: 5pt, inset: 8pt, width: 100%)[
  #text(size: size)[#body]
]
#let cols(..bodies) = grid(columns: (1fr, 1fr), gutter: 18pt, ..bodies)
#let caption(s) = text(fill: sub, size: 7.5pt)[#align(center)[#s]]
#let th(s) = text(fill: sub, size: 8pt, weight: "bold")[#s]
#let hl(s)  = text(fill: accent, weight: "bold")[#s]
#let good(s) = text(fill: green, weight: "bold")[#s]
#let bad(s)  = text(fill: red, weight: "bold")[#s]
#let dim(s)  = text(fill: sub, size: 7.8pt)[#s]
#let tbl(columns, align: auto, ..cells) = table(
  columns: columns,
  align: align,
  stroke: 0.6pt + border,
  inset: 4.3pt,
  fill: (x, y) => if calc.even(y) { panel } else { bg },
  ..cells,
)
#let slide(body, size: none) = {
  if size != none { set text(size: size) }
  body
  pagebreak(weak: true)
}

